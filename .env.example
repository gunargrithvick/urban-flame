#  Copy this file to .env and fill in the two values that matter.
#
#    cp .env.example .env
#
#  .env is gitignored. tools/dev-server.mjs, tools/db-init.mjs and the test
#  harness read it; Vercel ignores it and uses its own project settings, so
#  anything set here has to be set there too before a deploy sees it.
#
#  Every variable below is optional. With none of them set the site still runs:
#  the API answers 503 database_unavailable, main.js reads that as "no server"
#  and keeps accounts, bookings and enquiries in localStorage instead.

#  Postgres connection string. Neon, Supabase and a local postgres all work.
#  Vercel's Neon and Supabase integrations set POSTGRES_URL for you, which
#  lib/config.mjs accepts as an alias, so on Vercel you usually set neither.
#  Managed providers need TLS; a local server usually has to be told not to.
DATABASE_URL=postgres://urban_flame:urban_flame@localhost:5432/urban_flame?sslmode=disable

#  Who may open admin.html. Comma-separated, matched case-insensitively against
#  the signed-in account's email. Deliberately not a column in the database:
#  a flag that lives in a table is one SQL mistake away from self-assignable.
#  Empty means nobody, which is the right default for a fresh deploy.
ADMIN_EMAILS=

#  Drops Secure from the session cookie so a plain-http localhost can keep it.
#  tools/dev-server.mjs sets this itself. Never set it on a deployed site: it
#  would let the session cookie travel unencrypted.
#UF_INSECURE_COOKIES=1
