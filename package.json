{
  "name": "urban-flame",
  "version": "3.0.0",
  "private": true,
  "description": "Restaurant site for Urban Flame in Indiranagar, Bengaluru: hand-written static pages, plus an optional Postgres-backed API for accounts, enquiries and table bookings. No build step either way.",
  "license": "MIT",
  "scripts": {
    "start": "node tools/dev-server.mjs",
    "serve": "http-server public -p 8080 -c-1",
    "db:init": "node tools/db-init.mjs",
    "check": "node tools/check.mjs",
    "responsive": "node tools/responsive.mjs",
    "images": "python tools/optimize_images.py",
    "screenshots": "node tools/screenshots.mjs",
    "test": "node tools/check.mjs && node --test test/unit.test.mjs test/api.test.mjs"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "http-server": "14.1.1"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
